  "Database Model": {
    "prefix": "eas-model",
    "body": [
      "class ${1:ModelName}(db.Model):",
      "    \"\"\"${2:Model description}\"\"\"",
      "    __tablename__ = '${3:table_name}'",
      "    ",
      "    id = db.Column(db.Integer, primary_key=True)",
      "    ${4:field_name} = db.Column(db.${5:String}(${6:255}), nullable=${7:False})",
      "    created_at = db.Column(db.DateTime, nullable=False, default=datetime.utcnow)",
      "    updated_at = db.Column(db.DateTime, nullable=True, default=datetime.utcnow, onupdate=datetime.utcnow)",
      "    ",
      "    def to_dict(self):",
      "        \"\"\"Convert model to dictionary.\"\"\"",
      "        return {",
      "            'id': self.id,",
      "            '${4:field_name}': self.${4:field_name},",
      "            'created_at': self.created_at.isoformat() if self.created_at else None,",
      "            'updated_at': self.updated_at.isoformat() if self.updated_at else None",
      "        }",
      "    ",
      "    def __repr__(self):",
      "        return f'<${1:ModelName} id={self.id}>'"
    ],
    "description": "Create a SQLAlchemy database model"
  },
