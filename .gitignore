.env
.env.*
!.env.example
!stack.env
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
.idea/

# Runtime-generated secret key (auto-created when SECRET_KEY is absent from .env)
.secret_key
.secret_key.tmp

# VSCode local settings (may contain secrets)
.vscode/settings.local.json
.vscode/sqltools.settings.json

logs/
*.log
static/eas_messages/
*.sqlite3

# Certbot certificates and data (contains private keys)
certbot_data/

# Docker Compose override files (site-specific)
docker-compose.override.yml

# Development data
dev_data/

# OSM tile cache for the share-card renderer — fills up at runtime and
# never belongs in version control.
data/tile-cache/

# Operator-uploaded MaxMind GeoLite2 databases for Traffic Analytics. These are
# runtime data and MaxMind's license forbids redistribution — never commit them.
data/geoip/

# MkDocs documentation build
site/
.cache/

# Python virtual environments (contributors create `venv` per the README
# Contributing guide; never commit the interpreter/site-packages tree).
venv/
.venv/
env/

# Pytest
.pytest_cache/
tests/logs/*.log
tests/test_data/*
!tests/test_data/README.md
!tests/logs/README.md
htmlcov/
.coverage

# Bare metal ISO build artifacts
/tmp/eas-station-iso-build/
bare-metal/scripts/*.iso
*.iso

# Development-only directories (not for ISO)
bugs/
tests/bug_reproductions/

# Don't allow root clutter - keep docs in proper directories
/*_FIX*.md
/*_DIAGNOSTIC*.md
/*_DEPLOYMENT*.md
/*_APPLIED*.md
/*_REMOVAL*.md
/*_AUDIT*.md
/*_SUMMARY*.md
/APPLY_*.md
/DEPLOY_*.sh
/FIX_*.md
/FIXES_*.md


# Tamper-evident audit-log signing key (Ed25519 private key) - NEVER commit.
# install.sh/update.sh generate this under the install dir, which is a git
# checkout in production. See docs/security/AUDIT_LOG_INTEGRITY.md.
secrets/
