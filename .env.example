SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=false
FLASK_ENV=production
# Set to 'https' in production so session cookies are Secure and HSTS is sent
PREFERRED_URL_SCHEME=https
# Explicitly enforce Secure flag on session cookies (defaults to true when PREFERRED_URL_SCHEME=https)
SESSION_COOKIE_SECURE=true
DOMAIN_NAME=localhost
SSL_EMAIL=admin@example.com
CERTBOT_STAGING=0
DATABASE_URL=postgresql+psycopg2://eas_station:change-me@127.0.0.1:5432/alerts
POLL_INTERVAL_SEC=120
NOAA_USER_AGENT=EAS Station (+https://github.com/KR8MER/eas-station; support@easstation.com)
IPAWS_CAP_FEED_URLS=
LOCATION_CONFIG="{\"timezone\": \"America/New_York\", \"county_name\": \"Your County\", \"state_code\": \"OH\", \"zone_codes\": \"\", \"fips_codes\": \"\", \"storage_zone_codes\": \"\", \"map_center_lat\": 40.0, \"map_center_lng\": -83.0, \"map_zoom\": 9}"
EAS_BROADCAST_ENABLED=true
EAS_ORIGINATOR=WXR
EAS_STATION_ID=STATION
EAS_OUTPUT_DIR=static/eas_messages
EAS_TTS_PROVIDER=pyttsx3
AZURE_OPENAI_CONFIG="{\"endpoint\": \"https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT/audio/speech?api-version=2025-03-01-preview\", \"key\": \"\", \"model\": \"tts-1\", \"voice\": \"alloy\", \"speed\": 1.0}"
LOG_LEVEL=INFO
LOG_FILE=logs/eas_station.log
WEB_ACCESS_LOG=false
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_REDIS_URL=redis://localhost:6379/0
MAX_WORKERS=2
EAS_SCAN_INTERVAL=3.0
MAX_CONCURRENT_EAS_SCANS=2
BACKUP_DIR=/var/backups/eas-station
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
TZ=America/New_York

# ============================================================================
# Hardware Configuration
# ============================================================================
# All hardware settings (GPIO, OLED, LED Sign, VFD Display) are now
# configured via the web UI at:
#   http://your-server/admin/hardware
#
# Settings are stored in the database (hardware_settings table).
# This eliminates scattered environment variables and provides a
# user-friendly point-and-click interface.
# ============================================================================

# ============================================================================
# Icecast Streaming Configuration
# ============================================================================
# All Icecast streaming settings are now configured via the web UI at:
#   http://your-server/admin/icecast
#
# Settings are stored in the database (icecast_settings table).
# This eliminates JSON configuration and provides individual form fields
# for server, port, passwords, stream name, etc.
# ============================================================================
