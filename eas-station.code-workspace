{
  "folders": [
    {
      "name": "EAS Station",
      "path": "."
    }
  ],
  "settings": {
    // Python Configuration
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.extraPaths": [
      "${workspaceFolder}",
      "${workspaceFolder}/app_core",
      "${workspaceFolder}/app_utils",
      "${workspaceFolder}/webapp"
    ],
    
    // Linting and Formatting
    "python.linting.enabled": false,
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": false,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
      }
    },
    
    // Flake8 Configuration
    "flake8.args": [
      "--max-line-length=120",
      "--ignore=E501,W503"
    ],
    
    // Testing
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
      "tests"
    ],
    
    // File Associations
    "files.associations": {
      "*.env.example": "properties",
      "*.service": "systemd",
      ".env": "properties"
    },
    
    // Files to Exclude from Explorer
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/*.pyo": true,
      "**/venv": true,
      "**/.pytest_cache": true,
      "**/htmlcov": true,
      "**/.coverage": true
    },
    
    // Search Exclusions
    "search.exclude": {
      "**/venv": true,
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/.git": true,
      "**/htmlcov": true
    },
    
    // Terminal Configuration
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder}"
    },
    "terminal.integrated.env.osx": {
      "PYTHONPATH": "${workspaceFolder}"
    },
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder}"
    },
    
    // Git Configuration
    "git.ignoreLimitWarning": true,
    
    // Editor Settings
    "editor.rulers": [120],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    
    // File Watcher Exclusions (Performance)
    "files.watcherExclude": {
      "**/venv/**": true,
      "**/__pycache__/**": true,
      "**/logs/**": true,
      "**/static/eas_messages/**": true
    },
    
    // PostgreSQL Database Configuration (Local Development)
    // Password will be prompted when connecting
    "sqltools.connections": [
      {
        "name": "EAS Station Database (Local)",
        "driver": "PostgreSQL",
        "server": "localhost",
        "port": 5432,
        "database": "alerts",
        "username": "eas_station",
        "askForPassword": true,
        "connectionTimeout": 30,
        "previewLimit": 50,
        "pgOptions": {
          "ssl": false
        },
        "group": "EAS Station",
        "icons": {
          "active": "🗄️",
          "inactive": "💾"
        }
      }
    ],
    "sqltools.useNodeRuntime": true,
    "sqltools.autoOpenSessionFiles": false,
    "sqltools.defaultExportType": "csv",
    "sqltools.results": {
      "limit": 100,
      "location": "current"
    },
    "sqltools.format": {
      "language": "sql",
      "reservedWordCase": "upper"
    }
  },
  "extensions": {
    "recommendations": [
      // Python Development (REQUIRED)
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy",
      "ms-python.black-formatter",
      "ms-python.flake8",
      
      // Database Tools
      "mtxr.sqltools",
      "mtxr.sqltools-driver-pg",
      
      // Git and Version Control
      "eamodio.gitlens",
      
      // File Format Support
      "foxundermoon.shell-format",
      "redhat.vscode-yaml",
      "DavidAnson.vscode-markdownlint",
      
      // Systemd service files
      "hangxingliu.vscode-systemd-support",
      
      // .env file support
      "mikestead.dotenv",
      
      // Docker (for understanding deployment)
      "ms-azuretools.vscode-docker",
      
      // AI Coding Assistants (Optional)
      "github.copilot",
      "github.copilot-chat",
      
      // REST API Testing
      "humao.rest-client",
      
      // Productivity
      "aaron-bond.better-comments",
      "oderwat.indent-rainbow",
      "PKief.material-icon-theme",
      
      // Remote Development (for SSH workflow)
      "ms-vscode-remote.remote-ssh",
      "ms-vscode-remote.remote-ssh-edit"
    ],
    "unwantedRecommendations": [
      "ms-python.pylint"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flask Web App (Development)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/app.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "FLASK_ENV": "development",
          "FLASK_DEBUG": "true",
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": false,
        "stopOnEntry": false,
        "args": []
      },
      {
        "name": "FastAPI App (Development)",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "fastapi_app:app",
          "--reload",
          "--host",
          "0.0.0.0",
          "--port",
          "8000"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": false
      },
      {
        "name": "EAS Monitoring Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/eas_monitoring_service.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": false
      },
      {
        "name": "Hardware Service",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/hardware_service.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": false
      },
      {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": true
      },
      {
        "name": "Pytest: Current File",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "${file}",
          "-v",
          "-s"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": false
      },
      {
        "name": "Pytest: All Tests",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "tests/",
          "-v"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "envFile": "${workspaceFolder}/.env",
        "justMyCode": false
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Flask: Run Development Server",
        "type": "shell",
        "command": "source ${workspaceFolder}/venv/bin/activate && FLASK_ENV=development FLASK_DEBUG=true python app.py",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": true
        },
        "isBackground": true,
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "windows": {
          "command": "${workspaceFolder}\\venv\\Scripts\\activate && set FLASK_ENV=development && set FLASK_DEBUG=true && python app.py"
        }
      },
      {
        "label": "Run Pytest",
        "type": "shell",
        "command": "${workspaceFolder}/venv/bin/pytest",
        "args": [
          "tests/",
          "-v"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "windows": {
          "command": "${workspaceFolder}\\venv\\Scripts\\pytest"
        }
      },
      {
        "label": "Run Flake8",
        "type": "shell",
        "command": "${workspaceFolder}/venv/bin/flake8",
        "args": [
          "app.py",
          "app_core/",
          "app_utils/",
          "webapp/",
          "--max-line-length=120"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "windows": {
          "command": "${workspaceFolder}\\venv\\Scripts\\flake8"
        }
      },
      {
        "label": "Database: Show Alert Count",
        "type": "shell",
        "command": "psql",
        "args": [
          "-h",
          "localhost",
          "-U",
          "eas_station",
          "-d",
          "alerts",
          "-c",
          "SELECT COUNT(*) FROM cap_alerts;"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Database: Show Recent Alerts",
        "type": "shell",
        "command": "psql",
        "args": [
          "-h",
          "localhost",
          "-U",
          "eas_station",
          "-d",
          "alerts",
          "-c",
          "SELECT id, event, headline, sent FROM cap_alerts ORDER BY sent DESC LIMIT 10;"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Redis: Check Status",
        "type": "shell",
        "command": "redis-cli ping && echo '✓ Redis is running!' || echo '✗ Redis is not responding'",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Redis: List All Keys",
        "type": "shell",
        "command": "redis-cli",
        "args": [
          "KEYS",
          "*"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Install Python Dependencies",
        "type": "shell",
        "command": "${workspaceFolder}/venv/bin/pip",
        "args": [
          "install",
          "-r",
          "${workspaceFolder}/requirements.txt"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "windows": {
          "command": "${workspaceFolder}\\venv\\Scripts\\pip"
        }
      },
      {
        "label": "Run Alembic Migrations",
        "type": "shell",
        "command": "source ${workspaceFolder}/venv/bin/activate && alembic upgrade head",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "windows": {
          "command": "${workspaceFolder}\\venv\\Scripts\\activate && alembic upgrade head"
        }
      }
    ]
  }
}
