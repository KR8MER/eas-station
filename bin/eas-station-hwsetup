#!/usr/bin/env python3
"""EAS Station hardware-setup helper daemon.

Runs as root and exposes a tiny Unix-socket RPC that the web service
(running unprivileged as ``eas-station``) calls to perform privileged
GPS HAT setup operations — ``apt install`` of missing packages,
idempotent edits to ``/etc/default/gpsd``, ``/etc/chrony/chrony.conf``,
and ``/boot/firmware/config.txt``, ``hwclock -w`` after PORF, and
``systemctl`` enable/restart of chrony / gpsd. Only commands explicitly
registered in :data:`COMMANDS` are accepted — every other request is
rejected.

This file is deliberately stdlib-only. Keeping the helper free of
project imports means the root-privileged surface is small, auditable,
and decoupled from the rest of the codebase, so a SQLAlchemy /
Flask-WTF / Jinja2 vulnerability can never reach root through this
daemon.

Wire format (JSON-Lines over a Unix stream socket):

* Request: one line, ``{"action": "<name>", "params": {...},
  "request_id": "<uuid>"}``.
* Response: zero or more streaming events
  ``{"type": "stdout"|"stderr", "data": "..."}``, then exactly one
  terminal event ``{"type": "result", "ok": bool, "exit_code": int,
  "error": "..."}``. Connection closes after the result event.

Socket layout: ``/run/eas-station/hwsetup.sock``, mode ``0660``,
owned by ``root:eas-station`` so only the service user can connect.
The directory is created on startup if missing.

For end-to-end verification this initial revision implements only the
``ping`` action (returns ``pong`` and exits 0). Real actions land in
subsequent commits, each with their own validation and tests.
"""

from __future__ import annotations

import argparse
import errno
import grp
import json
import logging
import logging.handlers
import os
import re
import shutil
import socket
import socketserver
import stat
import subprocess
import sys
import threading
import time
import traceback
import uuid
from typing import Any, Callable, Dict, List, Optional, Tuple

# ---------------------------------------------------------------------------
# Configuration constants. Kept at module scope so unit-style tests can
# patch them, and so deployers can grep for them in a single place.
# ---------------------------------------------------------------------------

DEFAULT_SOCKET_PATH = "/run/eas-station/hwsetup.sock"
DEFAULT_OWNER_GROUP = "eas-station"
DEFAULT_SOCKET_MODE = 0o660

# Per-connection limits — bound a single client's blast radius.
MAX_REQUEST_BYTES = 64 * 1024     # 64 KiB request line is plenty for JSON
MAX_PARAM_DEPTH = 4               # how nested a params object may be
DEFAULT_REQUEST_TIMEOUT_S = 5.0   # ping is a no-op; later actions raise this

LOG = logging.getLogger("eas-station-hwsetup")


# ---------------------------------------------------------------------------
# Command registry. Each entry returns a dict that becomes the terminal
# ``result`` event. Commands that need to stream stdout/stderr will use
# the ``emit`` callback (added in the action commits) instead of returning
# all data in one shot.
# ---------------------------------------------------------------------------

CommandFn = Callable[[Dict[str, Any], "EmitFn"], Dict[str, Any]]
EmitFn = Callable[[str, str], None]   # (channel, data) → None; channel ∈ {stdout, stderr}


def _cmd_ping(params: Dict[str, Any], emit: EmitFn) -> Dict[str, Any]:
    """Simplest possible action — used for end-to-end socket verification.

    Echoes any ``message`` parameter back, otherwise returns "pong".
    """
    msg = params.get("message", "pong")
    if not isinstance(msg, str) or len(msg) > 256:
        return {"ok": False, "exit_code": 22, "error": "message must be a short string"}
    emit("stdout", msg)
    return {"ok": True, "exit_code": 0, "stdout": msg}


# ---------------------------------------------------------------------------
# Subprocess helper. Every real action runs at least one external command,
# so we centralise the "run with timeout, stream output, never use a
# shell" pattern here. All argv must be lists of strings the action
# itself controls — no caller-supplied strings ever land in argv.
# ---------------------------------------------------------------------------

def _run_streaming(
    argv: List[str],
    emit: EmitFn,
    *,
    timeout: float = 30.0,
    label: Optional[str] = None,
) -> Tuple[int, str, str]:
    """Run ``argv`` (no shell), stream stdout/stderr to ``emit`` line-by-line,
    and return ``(exit_code, stdout_full, stderr_full)``.

    Any caller-derived data must already have been validated against an
    allowlist by the time it reaches here. ``argv[0]`` may be a bare name
    only when the caller has confirmed a specific path with shutil.which;
    otherwise pass an absolute path.
    """
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        raise ValueError("argv must be a non-empty list of strings")
    label = label or argv[0]
    emit("stdout", f"$ {' '.join(argv)}\n")
    try:
        proc = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL,
            close_fds=True,
            text=True,
            bufsize=1,
        )
    except FileNotFoundError as exc:
        emit("stderr", f"{label}: {exc}\n")
        return 127, "", str(exc)
    except OSError as exc:
        emit("stderr", f"{label}: {exc}\n")
        return getattr(exc, "errno", 1) or 1, "", str(exc)

    stdout_buf: List[str] = []
    stderr_buf: List[str] = []

    def pump(stream, channel: str, buf: List[str]) -> None:
        try:
            for line in iter(stream.readline, ""):
                buf.append(line)
                emit(channel, line)
        except Exception as exc:
            emit("stderr", f"[{label}] read error: {exc}\n")
        finally:
            try:
                stream.close()
            except Exception:
                pass

    threads = [
        threading.Thread(target=pump, args=(proc.stdout, "stdout", stdout_buf), daemon=True),
        threading.Thread(target=pump, args=(proc.stderr, "stderr", stderr_buf), daemon=True),
    ]
    for t in threads:
        t.start()

    try:
        rc = proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.wait(timeout=2)
        except Exception:
            pass
        emit("stderr", f"[{label}] timed out after {timeout:.1f}s\n")
        rc = 124

    for t in threads:
        t.join(timeout=2)

    return rc, "".join(stdout_buf), "".join(stderr_buf)


# ---------------------------------------------------------------------------
# seed_rtc — write the (synchronized) system clock back to the RTC,
# clearing the RV-3028 / DS3231 PORF flag. This is the "I just replaced
# the coin cell" / "I just brought up a fresh HAT" recovery path.
#
# Params:
#   force_unsynced (bool, default False) — proceed even if timedatectl
#     reports the system clock is not yet NTP/GPS-synchronized. Off by
#     default because writing a wrong system time to the RTC and then
#     trusting it on next boot is a footgun; the UI surfaces the flag
#     explicitly with a "I know what I'm doing" checkbox.
#
# Result fields beyond ok / exit_code:
#   system_time_iso   — datetime stamp the system reported at the start
#   rtc_time_after    — output of `hwclock -r` after the write
#   ntp_synchronized  — boolean from timedatectl
# ---------------------------------------------------------------------------

def _which_required(name: str) -> Optional[str]:
    """shutil.which() but explicitly searches the privileged PATH the
    helper uses. Returns None if the binary is missing entirely."""
    return shutil.which(name)


def _read_timedatectl_synchronized() -> Tuple[Optional[bool], Optional[str]]:
    """Return (synchronized, error). synchronized is True/False/None
    where None means timedatectl couldn't be parsed."""
    if not _which_required("timedatectl"):
        return None, "timedatectl not installed"
    try:
        result = subprocess.run(
            ["timedatectl", "show", "--property=NTPSynchronized", "--value"],
            capture_output=True, text=True, timeout=4.0, check=False,
        )
    except Exception as exc:
        return None, f"timedatectl failed: {exc}"
    if result.returncode != 0:
        return None, f"timedatectl exited {result.returncode}: {result.stderr.strip()}"
    val = (result.stdout or "").strip().lower()
    if val in ("yes", "true"):
        return True, None
    if val in ("no", "false"):
        return False, None
    return None, f"unexpected timedatectl output: {val!r}"


def _cmd_seed_rtc(params: Dict[str, Any], emit: EmitFn) -> Dict[str, Any]:
    raw_force = params.get("force_unsynced", False)
    if not isinstance(raw_force, bool):
        return {
            "ok": False,
            "exit_code": 22,
            "error": "force_unsynced must be a boolean (true / false)",
        }
    force: bool = raw_force

    hwclock = _which_required("hwclock")
    if not hwclock:
        return {
            "ok": False,
            "exit_code": 127,
            "error": (
                "hwclock not found. On Pi OS Bookworm and newer, install "
                "util-linux-extra: sudo apt install -y util-linux-extra"
            ),
        }

    # 1. Synchronization gate.
    synced, sync_err = _read_timedatectl_synchronized()
    emit("stdout", f"timedatectl NTPSynchronized: {synced} (error={sync_err})\n")
    if synced is False and not force:
        return {
            "ok": False,
            "exit_code": 1,
            "error": (
                "System clock is not synchronized to NTP/GPS. Refusing to "
                "write a possibly-wrong time to the RTC. Either wait for "
                "chrony to converge, or re-run with force_unsynced=true."
            ),
            "ntp_synchronized": False,
        }

    system_time_iso = ""
    try:
        from datetime import datetime, timezone as _tz
        system_time_iso = datetime.now(_tz.utc).isoformat()
    except Exception:
        pass

    # 2. Write system time → RTC. -u forces UTC; --rtc /dev/rtc0 pins the
    #    target. Both are hardcoded — no caller input lands in argv.
    rc, _out, err = _run_streaming(
        [hwclock, "-w", "-u", "--rtc", "/dev/rtc0"],
        emit,
        timeout=8.0,
        label="hwclock -w",
    )
    if rc != 0:
        return {
            "ok": False,
            "exit_code": rc,
            "error": f"hwclock -w failed: {err.strip() or 'no stderr'}",
            "ntp_synchronized": synced,
            "system_time_iso": system_time_iso,
        }

    # 3. Read back. On a healthy chip this prints one line like
    #    "2026-05-08 21:29:08.000000+00:00".
    rc_r, out_r, err_r = _run_streaming(
        [hwclock, "-r", "-u", "--rtc", "/dev/rtc0"],
        emit,
        timeout=4.0,
        label="hwclock -r",
    )
    rtc_time_after = out_r.strip().splitlines()[-1] if out_r.strip() else ""
    if rc_r != 0:
        return {
            "ok": False,
            "exit_code": rc_r,
            "error": (
                "hwclock -w succeeded but hwclock -r failed: "
                + (err_r.strip() or "no stderr")
            ),
            "ntp_synchronized": synced,
            "system_time_iso": system_time_iso,
            "rtc_time_after": rtc_time_after,
        }

    return {
        "ok": True,
        "exit_code": 0,
        "ntp_synchronized": synced,
        "system_time_iso": system_time_iso,
        "rtc_time_after": rtc_time_after,
    }


# ---------------------------------------------------------------------------
# apt_install — install one or more packages from a hardcoded allowlist.
#
# The allowlist is the single security boundary for this action. Even if the
# web tier is compromised and starts asking for arbitrary package names,
# the helper rejects anything not in the set below. This is defense in
# depth — the web tier validates input too — but the helper is what stops
# someone from turning this RPC into ``apt install netcat-openbsd
# socat python3-pip`` and getting a remote shell on root.
#
# We deliberately do NOT support arbitrary "version pinning" or apt
# options. The action exists to fix one user-visible problem ("hwclock
# command not found", "chrony isn't installed") and that fix is always
# the same: install the latest distro package.
#
# Params:
#   packages (list[str]) — non-empty, every entry must be in
#     _APT_ALLOWLIST and match _APT_NAME_RE (defense in depth).
#   update_first (bool, default True) — run ``apt-get update`` before
#     install. The UI surfaces this as a checkbox so users on metered
#     links can skip it.
# ---------------------------------------------------------------------------

# Package names this helper is willing to install. Keep aligned with
# app_utils/gps_hat.py's _PACKAGES tuple (which is what the diagnostic
# panel surfaces as installable). Adding to this list is a deliberate
# security review event.
_APT_ALLOWLIST = frozenset({
    "chrony",
    "gpsd",
    "gpsd-clients",
    "pps-tools",
    "util-linux-extra",
    "i2c-tools",
})

# Belt-and-braces regex: even within the allowlist, refuse anything that
# doesn't look like a Debian binary package name. This stops a typo or
# corrupted allowlist from ever producing weird argv (and matches the
# Debian Policy §5.6.7 grammar for binary package names).
_APT_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9+\-.]+$")


def _cmd_apt_install(params: Dict[str, Any], emit: EmitFn) -> Dict[str, Any]:
    raw_packages = params.get("packages")
    if not isinstance(raw_packages, list) or not raw_packages:
        return {
            "ok": False,
            "exit_code": 22,
            "error": "packages must be a non-empty list of strings",
        }
    if len(raw_packages) > len(_APT_ALLOWLIST):
        return {
            "ok": False,
            "exit_code": 22,
            "error": f"too many packages requested (max {len(_APT_ALLOWLIST)})",
        }
    cleaned: List[str] = []
    for entry in raw_packages:
        if not isinstance(entry, str):
            return {
                "ok": False,
                "exit_code": 22,
                "error": "every package name must be a string",
            }
        name = entry.strip()
        if not _APT_NAME_RE.match(name):
            return {
                "ok": False,
                "exit_code": 22,
                "error": f"package name failed sanity check: {name!r}",
            }
        if name not in _APT_ALLOWLIST:
            return {
                "ok": False,
                "exit_code": 22,
                "error": (
                    f"package {name!r} is not in the helper allowlist. "
                    "Adding a package requires editing the helper itself "
                    "(see _APT_ALLOWLIST in eas-station-hwsetup)."
                ),
                "allowlist": sorted(_APT_ALLOWLIST),
            }
        if name not in cleaned:  # de-dup, preserve order
            cleaned.append(name)

    raw_update = params.get("update_first", True)
    if not isinstance(raw_update, bool):
        return {
            "ok": False,
            "exit_code": 22,
            "error": "update_first must be a boolean",
        }

    apt_get = _which_required("apt-get")
    if not apt_get:
        return {
            "ok": False,
            "exit_code": 127,
            "error": "apt-get not found — this helper only supports Debian-family distributions.",
        }

    # apt-get tries hard to be interactive. Force non-interactive mode and
    # disable any installer prompts, so an unattended unit-file or
    # debconf-prompt question can never wedge the helper.
    env = dict(os.environ)
    env["DEBIAN_FRONTEND"] = "noninteractive"
    env["APT_LISTCHANGES_FRONTEND"] = "none"
    # "lock" tools intermittently fight each other on Pi OS during boot;
    # this option makes apt wait for the lock instead of failing fast.
    apt_options = [
        "-y",
        "-o", "Dpkg::Options::=--force-confdef",
        "-o", "Dpkg::Options::=--force-confold",
        "-o", "DPkg::Lock::Timeout=60",
    ]

    overall_stdout: List[str] = []
    overall_stderr: List[str] = []

    if raw_update:
        emit("stdout", "[1/2] apt-get update\n")
        rc, out, err = _run_streaming_env(
            [apt_get, "update", "-q", *apt_options[:1]],
            emit,
            env=env,
            timeout=180.0,
            label="apt-get update",
        )
        overall_stdout.append(out)
        overall_stderr.append(err)
        if rc != 0:
            return {
                "ok": False,
                "exit_code": rc,
                "error": (
                    "apt-get update failed. Network or repository problem; "
                    "try again, or pass update_first=false to skip it."
                ),
                "packages": cleaned,
            }
    else:
        emit("stdout", "[1/2] apt-get update — skipped (update_first=false)\n")

    emit("stdout", f"[2/2] apt-get install {' '.join(cleaned)}\n")
    rc, out, err = _run_streaming_env(
        [apt_get, "install", *apt_options, "--", *cleaned],
        emit,
        env=env,
        timeout=600.0,
        label="apt-get install",
    )
    overall_stdout.append(out)
    overall_stderr.append(err)
    if rc != 0:
        return {
            "ok": False,
            "exit_code": rc,
            "error": (
                "apt-get install failed. See streamed stderr for details. "
                "Common causes: missing apt cache (run with update_first=true), "
                "package conflicts, or insufficient disk space."
            ),
            "packages": cleaned,
            "stderr": err.strip()[:2000],
        }

    # Verify each package is now in 'install ok installed' state. apt-get
    # exits 0 even when a package wasn't actually installed (e.g. mid-pipe
    # cancellation, debconf timeout) so this is the authoritative check.
    installed_state: Dict[str, str] = {}
    dpkg_query = _which_required("dpkg-query")
    if dpkg_query:
        for name in cleaned:
            try:
                r = subprocess.run(
                    [dpkg_query, "-W", "-f=${Status}", name],
                    capture_output=True, text=True, timeout=5.0, check=False,
                )
                installed_state[name] = (r.stdout or "").strip() or "unknown"
            except Exception as exc:
                installed_state[name] = f"query failed: {exc}"
    not_installed = [
        name for name, status in installed_state.items()
        if "install ok installed" not in status
    ]
    if not_installed:
        return {
            "ok": False,
            "exit_code": 1,
            "error": (
                "apt-get reported success but the following packages are "
                f"not in the 'installed' state: {', '.join(not_installed)}"
            ),
            "packages": cleaned,
            "installed_state": installed_state,
        }

    return {
        "ok": True,
        "exit_code": 0,
        "packages": cleaned,
        "installed_state": installed_state,
    }


def _run_streaming_env(
    argv: List[str],
    emit: EmitFn,
    *,
    env: Optional[Dict[str, str]] = None,
    timeout: float = 30.0,
    label: Optional[str] = None,
) -> Tuple[int, str, str]:
    """Variant of :func:`_run_streaming` that takes an explicit env dict.

    Used by ``apt_install`` to inject ``DEBIAN_FRONTEND=noninteractive``
    without leaking it into the helper's own environment. Behaviour is
    otherwise identical — same threading model, same timeout semantics,
    same line-by-line streaming through ``emit``.
    """
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        raise ValueError("argv must be a non-empty list of strings")
    label = label or argv[0]
    emit("stdout", f"$ {' '.join(argv)}\n")
    try:
        proc = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL,
            close_fds=True,
            text=True,
            bufsize=1,
            env=env,
        )
    except FileNotFoundError as exc:
        emit("stderr", f"{label}: {exc}\n")
        return 127, "", str(exc)
    except OSError as exc:
        emit("stderr", f"{label}: {exc}\n")
        return getattr(exc, "errno", 1) or 1, "", str(exc)

    stdout_buf: List[str] = []
    stderr_buf: List[str] = []

    def pump(stream, channel: str, buf: List[str]) -> None:
        try:
            for line in iter(stream.readline, ""):
                buf.append(line)
                emit(channel, line)
        except Exception as exc:
            emit("stderr", f"[{label}] read error: {exc}\n")
        finally:
            try:
                stream.close()
            except Exception:
                pass

    threads = [
        threading.Thread(target=pump, args=(proc.stdout, "stdout", stdout_buf), daemon=True),
        threading.Thread(target=pump, args=(proc.stderr, "stderr", stderr_buf), daemon=True),
    ]
    for t in threads:
        t.start()

    try:
        rc = proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.wait(timeout=2)
        except Exception:
            pass
        emit("stderr", f"[{label}] timed out after {timeout:.1f}s\n")
        rc = 124

    for t in threads:
        t.join(timeout=2)

    return rc, "".join(stdout_buf), "".join(stderr_buf)


COMMANDS: Dict[str, CommandFn] = {
    "ping": _cmd_ping,
    "seed_rtc": _cmd_seed_rtc,
    "apt_install": _cmd_apt_install,
}


# ---------------------------------------------------------------------------
# Request validation
# ---------------------------------------------------------------------------

class RequestError(ValueError):
    """Raised for any malformed or out-of-policy request."""


def _validate_request(raw: bytes) -> Dict[str, Any]:
    """Parse and shallow-validate a request line. Returns the request dict."""
    if not raw:
        raise RequestError("empty request")
    if len(raw) > MAX_REQUEST_BYTES:
        raise RequestError(f"request exceeds {MAX_REQUEST_BYTES} bytes")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise RequestError(f"request is not valid UTF-8: {exc}") from exc
    try:
        obj = json.loads(text)
    except json.JSONDecodeError as exc:
        raise RequestError(f"request is not valid JSON: {exc}") from exc
    if not isinstance(obj, dict):
        raise RequestError("request must be a JSON object")
    action = obj.get("action")
    if not isinstance(action, str) or not action:
        raise RequestError("missing action")
    if action not in COMMANDS:
        raise RequestError(f"unknown action: {action}")
    params = obj.get("params", {})
    if not isinstance(params, dict):
        raise RequestError("params must be an object")
    _check_depth(params, MAX_PARAM_DEPTH)
    rid = obj.get("request_id")
    if rid is not None and not isinstance(rid, str):
        raise RequestError("request_id must be a string if present")
    return {
        "action": action,
        "params": params,
        "request_id": rid or str(uuid.uuid4()),
    }


def _check_depth(obj: Any, remaining: int) -> None:
    if remaining < 0:
        raise RequestError("params nesting too deep")
    if isinstance(obj, dict):
        for v in obj.values():
            _check_depth(v, remaining - 1)
    elif isinstance(obj, list):
        for v in obj:
            _check_depth(v, remaining - 1)


# ---------------------------------------------------------------------------
# Socket plumbing
# ---------------------------------------------------------------------------

class _ConnectionHandler(socketserver.BaseRequestHandler):
    """Handle one client connection: read a single request line, dispatch,
    stream events back, close the socket."""

    server: "_HelperServer"

    def handle(self) -> None:
        sock: socket.socket = self.request
        sock.settimeout(DEFAULT_REQUEST_TIMEOUT_S)
        peer_creds = _get_peer_creds(sock)
        peer_label = f"pid={peer_creds[0]} uid={peer_creds[1]} gid={peer_creds[2]}" if peer_creds else "unknown"

        try:
            raw = _read_line(sock, MAX_REQUEST_BYTES)
        except Exception as exc:
            LOG.warning("[%s] failed to read request: %s", peer_label, exc)
            _send_event(sock, {"type": "result", "ok": False, "exit_code": 1, "error": str(exc)})
            return

        try:
            req = _validate_request(raw)
        except RequestError as exc:
            LOG.warning("[%s] rejected request: %s", peer_label, exc)
            _send_event(sock, {"type": "result", "ok": False, "exit_code": 22, "error": str(exc)})
            return

        rid = req["request_id"]
        action = req["action"]
        LOG.info("[%s] action=%s request_id=%s", peer_label, action, rid)

        def emit(channel: str, data: str) -> None:
            if channel not in ("stdout", "stderr"):
                channel = "stdout"
            try:
                _send_event(sock, {"type": channel, "data": data, "request_id": rid})
            except Exception as exc:
                LOG.debug("emit failed: %s", exc)

        handler = COMMANDS[action]
        try:
            result = handler(req["params"], emit)
        except Exception as exc:
            LOG.exception("[%s] action=%s raised: %s", peer_label, action, exc)
            result = {
                "ok": False,
                "exit_code": 1,
                "error": f"{type(exc).__name__}: {exc}",
                "traceback": traceback.format_exc(limit=3),
            }

        result.setdefault("ok", False)
        result.setdefault("exit_code", 1)
        result["type"] = "result"
        result["request_id"] = rid
        _send_event(sock, result)


class _HelperServer(socketserver.ThreadingUnixStreamServer):
    """Threaded Unix-socket server. Each connection is a one-shot
    request/response so threading is just there to keep one client from
    blocking another."""

    daemon_threads = True
    allow_reuse_address = True


def _get_peer_creds(sock: socket.socket) -> Optional[tuple]:
    """Return ``(pid, uid, gid)`` of the connected peer via SO_PEERCRED.

    Used purely for log enrichment — access control is enforced by the
    socket's filesystem permissions, not by trusting the peer's claimed
    identity.
    """
    try:
        SO_PEERCRED = 17  # Linux constant; not exposed on all stdlibs
        creds = sock.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, 12)
        import struct
        pid, uid, gid = struct.unpack("=III", creds)
        return pid, uid, gid
    except Exception:
        return None


def _read_line(sock: socket.socket, max_bytes: int) -> bytes:
    """Read until newline or EOF, with a hard byte cap."""
    chunks = []
    received = 0
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        chunks.append(chunk)
        received += len(chunk)
        if received > max_bytes:
            raise RequestError(f"request exceeds {max_bytes} bytes")
        if b"\n" in chunk:
            break
    data = b"".join(chunks)
    nl = data.find(b"\n")
    if nl >= 0:
        data = data[:nl]
    return data.strip()


def _send_event(sock: socket.socket, event: Dict[str, Any]) -> None:
    line = (json.dumps(event, ensure_ascii=False) + "\n").encode("utf-8")
    try:
        sock.sendall(line)
    except (BrokenPipeError, ConnectionResetError):
        pass


# ---------------------------------------------------------------------------
# Daemon entry point
# ---------------------------------------------------------------------------

def _ensure_socket_dir(path: str) -> None:
    parent = os.path.dirname(path) or "/"
    if parent and not os.path.isdir(parent):
        os.makedirs(parent, mode=0o755, exist_ok=True)


def _set_socket_perms(path: str, group: str, mode: int) -> None:
    """Chgrp + chmod the socket so only ``group`` members can connect."""
    try:
        gid = grp.getgrnam(group).gr_gid
    except KeyError:
        LOG.warning("group %r not found; leaving socket group as default", group)
        gid = -1
    try:
        os.chown(path, 0, gid)
    except PermissionError as exc:
        LOG.warning("failed to chown %s to root:%s: %s", path, group, exc)
    try:
        os.chmod(path, mode)
    except PermissionError as exc:
        LOG.warning("failed to chmod %s to %#o: %s", path, mode, exc)
    st = os.stat(path)
    if not stat.S_ISSOCK(st.st_mode):
        raise RuntimeError(f"{path} is not a socket")


def _setup_logging(verbose: bool) -> None:
    level = logging.DEBUG if verbose else logging.INFO
    logging.basicConfig(
        level=level,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
        stream=sys.stderr,
    )
    # Also log to syslog when available so audit events survive a restart.
    try:
        handler = logging.handlers.SysLogHandler(address="/dev/log")
        handler.setFormatter(logging.Formatter(
            "eas-station-hwsetup[%(process)d]: %(levelname)s %(message)s"
        ))
        LOG.addHandler(handler)
    except Exception as exc:
        LOG.debug("syslog handler unavailable: %s", exc)


def main(argv: Optional[list] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="eas-station-hwsetup",
        description="Privileged GPS HAT setup helper for EAS Station.",
    )
    parser.add_argument("--socket", default=DEFAULT_SOCKET_PATH,
                        help=f"Unix socket path (default: {DEFAULT_SOCKET_PATH})")
    parser.add_argument("--group", default=DEFAULT_OWNER_GROUP,
                        help=f"Group allowed to connect (default: {DEFAULT_OWNER_GROUP})")
    parser.add_argument("--mode", default="0660",
                        help="Octal socket mode (default: 0660)")
    parser.add_argument("--verbose", "-v", action="store_true")
    args = parser.parse_args(argv)

    _setup_logging(args.verbose)

    if os.geteuid() != 0:
        LOG.error("must run as root (effective uid=%d)", os.geteuid())
        return 1

    _ensure_socket_dir(args.socket)
    # Remove a stale socket from a previous crash
    if os.path.exists(args.socket):
        try:
            os.unlink(args.socket)
        except OSError as exc:
            LOG.error("failed to remove stale socket %s: %s", args.socket, exc)
            return 1

    server = _HelperServer(args.socket, _ConnectionHandler)
    _set_socket_perms(args.socket, args.group, int(args.mode, 8))
    LOG.info("listening on %s as root:%s mode=%s", args.socket, args.group, args.mode)

    try:
        server.serve_forever(poll_interval=1.0)
    except KeyboardInterrupt:
        LOG.info("shutdown requested")
    finally:
        server.server_close()
        try:
            os.unlink(args.socket)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
