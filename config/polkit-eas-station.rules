/*
 * EAS Station polkit rules
 * Install to: /etc/polkit-1/rules.d/60-eas-station.rules
 * Install with: sudo cp config/polkit-eas-station.rules /etc/polkit-1/rules.d/60-eas-station.rules
 *
 * Allows the eas-station service user to disable NTP via the systemd D-Bus
 * interface (org.freedesktop.timedate1.SetNTP) without interactive
 * authentication.  This is required because the GPS subsystem service
 * (eas-station-gps.service) runs under NoNewPrivileges=true, which
 * prevents sudo from elevating privileges.  The GPS manager calls
 * busctl directly to request the NTP disable when a PPS-backed GPS
 * fix is available so the GPS clock is not overridden.
 */
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.timedate1.set-ntp" &&
        subject.user === "eas-station") {
        return polkit.Result.YES;
    }
});
