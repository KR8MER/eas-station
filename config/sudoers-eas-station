# EAS Station sudoers configuration
# This file should be installed to: /etc/sudoers.d/eas-station
# Install with: sudo cp config/sudoers-eas-station /etc/sudoers.d/eas-station && sudo chmod 440 /etc/sudoers.d/eas-station
#
# Allows the eas-station user to run specific commands without password
# Required for the web UI to manage SSL certificates and system services
# Also allows root to run commands as eas-station without password (for update.sh)

# Allow root to run any command as eas-station user without password
# This is required for update.sh which runs as root and needs to execute
# git, pip, python, and alembic commands as the eas-station user
root ALL=(eas-station) NOPASSWD: ALL

# Certbot certificate management
# Allow all certbot commands since it's a trusted system tool that requires root
eas-station ALL=(ALL) NOPASSWD: /usr/bin/certbot

# Certbot data directory management
# These commands are needed to fix permissions on root-owned files created by certbot
# Using broader patterns since sudoers globbing is limited
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /opt/eas-station/certbot_data/config
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /opt/eas-station/certbot_data/work
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /opt/eas-station/certbot_data/logs
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chmod -R 777 /opt/eas-station/certbot_data
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chown -R root\:root /opt/eas-station/certbot_data
eas-station ALL=(ALL) NOPASSWD: /usr/bin/find /opt/eas-station/certbot_data -name .certbot.lock -delete
eas-station ALL=(ALL) NOPASSWD: /usr/bin/cat /opt/eas-station/certbot_data/logs/letsencrypt.log

# Webroot directory management (required for certbot webroot method)
# Certbot runs as root and needs to write challenge files to /var/www/certbot
# Nginx (www-data) needs to read these files to serve them to Let's Encrypt
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /var/www/certbot/.well-known/acme-challenge
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chown -R root\:root /var/www/certbot
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chmod -R 755 /var/www/certbot

# Nginx log directory management (DEPRECATED - not actively used)
# Certbot's nginx plugin has fundamental permission issues that cannot be reliably solved.
# We recommend using standalone or webroot modes instead of the nginx plugin.
# These sudoers entries are kept for backward compatibility and troubleshooting,
# but the nginx plugin is no longer the recommended method due to permission issues
# with nginx -t running in different security contexts (AppArmor, SELinux, etc.)
# PLANNED REMOVAL: Consider removing these entries in version 3.0.0 or later
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /var/log/nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chmod 755 /var/log/nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/touch /var/log/nginx/error.log
eas-station ALL=(ALL) NOPASSWD: /usr/bin/touch /var/log/nginx/access.log
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chown www-data\:adm /var/log/nginx/error.log
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chown www-data\:adm /var/log/nginx/access.log
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chmod 666 /var/log/nginx/error.log
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chmod 666 /var/log/nginx/access.log

# Certificate installation (required for installing certificates after obtaining them)
# These commands are used by _install_certificate_internal() in webapp/admin/certbot.py
# Note: Domain names are validated in Python before being passed to these commands
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /etc/letsencrypt
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /etc/letsencrypt/live
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /etc/nginx/snippets
eas-station ALL=(ALL) NOPASSWD: /usr/bin/rm -rf /etc/letsencrypt/live/*
eas-station ALL=(ALL) NOPASSWD: /usr/bin/ln -s * /etc/letsencrypt/live/*
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/nginx/snippets/ssl-letsencrypt.conf
eas-station ALL=(ALL) NOPASSWD: /usr/bin/sed -i * /etc/nginx/sites-available/eas-station
eas-station ALL=(ALL) NOPASSWD: /usr/bin/grep -q * /etc/nginx/sites-available/eas-station
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/nginx -t
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/nginx

# Nginx service management (required for standalone certbot mode)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl start nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active nginx
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl status nginx

# Certbot timer management (for automatic renewal)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl disable certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl start certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-enabled certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl status certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable --now certbot.timer
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl disable --now certbot.timer

# Icecast configuration management (required for password regeneration from web UI)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/cat /etc/icecast2/icecast.xml
eas-station ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/*.xml /etc/icecast2/icecast.xml
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart icecast2
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart icecast
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl status icecast2
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl status icecast

# EAS Station service management (required for Hardware Settings restart button and web UI service control)
# Hardware target restart bounces the five per-subsystem hardware units
# (network/zigbee/gps/displays/gpio) that replaced eas-station-hardware.service
# in Phase 4 of the hardware_service.py split.  The individual unit entries
# are kept so an operator can restart a single subsystem from the CLI without
# bouncing every hardware-side process.
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-hardware.target
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-network.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-zigbee.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-gps.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-displays.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-gpio.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-web.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-poller.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-sdr.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-eas.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-ipaws-poller.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-noaa-poller.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station.target

# One-click System Upgrade (Admin -> Operations). The wrapper launches
# update.sh as its own transient systemd unit (eas-station-update.service)
# rather than as a child of eas-station-web.service, so update.sh's own
# "Restarting Services" step doesn't kill the process reporting on it. The
# web UI polls the unit's state/journal with the two read-only entries below
# -- both work for any local user by systemd's default policy, but are
# granted explicitly here for consistency with every other systemctl read
# in this file, and in case a future hardening pass locks that down.
eas-station ALL=(ALL) NOPASSWD: /opt/eas-station/bin/eas-station-run-update *
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl show eas-station-update.service *
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active eas-station-update.service

# Audio service management (required to reload Icecast credentials after password change)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart eas-station-audio

# gpsd recovery (used by the GPS service's stuck-acquiring watchdog)
# gpsd can wedge after serial/USB hiccups — connected and chatty but never
# delivering a fix — and only a daemon restart clears it. The GPS manager
# detects that state and bounces gpsd through these entries.
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart gpsd.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart gpsd.socket

# Postfix local mail server management (required for mail server web UI)
# These commands are used by webapp/admin/mail_server.py to install, configure,
# and manage the local Postfix SMTP relay for outbound alert email delivery.

# Postfix service lifecycle
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active --quiet postfix
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable postfix
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl start postfix
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop postfix
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart postfix

# Postfix configuration inspection (read current hostname and sender map)
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/postconf myhostname
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/postconf sender_canonical_maps

# Postfix configuration validation
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/postfix check

# Write generated main.cf to /etc/postfix (web process cannot write there directly)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/postfix/main.cf

# Postfix installation via apt-get (non-interactive, suppresses debconf prompts)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get install -y postfix libsasl2-modules

# fail2ban management (required for the Security Center fail2ban tab)
# These commands are used by webapp/admin/fail2ban.py to install, configure,
# apply, and inspect host-level fail2ban jails for the EAS Station security log.
# IP addresses passed to fail2ban-client are validated in Python first.

# fail2ban service lifecycle
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active --quiet fail2ban
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable fail2ban
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl start fail2ban
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop fail2ban
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart fail2ban
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload-or-restart fail2ban

# fail2ban status inspection and ban/unban operations
eas-station ALL=(ALL) NOPASSWD: /usr/bin/fail2ban-client status
eas-station ALL=(ALL) NOPASSWD: /usr/bin/fail2ban-client status *
eas-station ALL=(ALL) NOPASSWD: /usr/bin/fail2ban-client -t
eas-station ALL=(ALL) NOPASSWD: /usr/bin/fail2ban-client set * unbanip *
eas-station ALL=(ALL) NOPASSWD: /usr/bin/fail2ban-client set * banip *

# Write generated jail/filter config (web process cannot write /etc/fail2ban directly)
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/fail2ban/jail.local
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/fail2ban/filter.d/eas-station-empty.conf

# Ensure the actuator jail's logpath exists as root. The web service runs under
# ProtectSystem=strict and may be unable to create /var/log/eas-station/security.log
# itself; if that file is missing fail2ban refuses to start the eas-station jail.
eas-station ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /var/log/eas-station
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee -a /var/log/eas-station/security.log

# fail2ban is shipped pre-installed via install.sh / update.sh (it is in the
# base package list), so the web UI never installs packages itself — it only
# configures, applies, and inspects the jails through the entries above.

# Security Checkup (Security Center -> Checkup tab): detects and, on request,
# repairs a host that's missing the baseline UFW firewall install.sh has
# configured automatically since v2.19.7. Deployments provisioned before that
# version never get it backfilled by update.sh (which only updates the
# application, not one-time host setup), so this reproduces install.sh's own
# Step 11 baseline (default-deny-incoming, 22/80/443 allowed, enabled) as an
# idempotent, web-triggerable action instead of a manual SSH procedure.
eas-station ALL=(ALL) NOPASSWD: /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get install -y ufw
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw status verbose
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw default deny incoming
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw default allow outgoing
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw allow 22/tcp
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw allow 80/tcp
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw allow 443/tcp
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw --force enable

# LAN NTP Server (Settings -> Network -> NTP Server): lets an admin serve
# chrony's already-synced time to a chosen set of subnets. Which subnets
# should be trusted is a per-deployment decision with no correct default
# (home LAN, office VLAN, Tailscale range, or nothing at all), so this is
# admin-configured rather than something install.sh could set up once.
# `ufw status verbose` above is reused for reading back the tagged rules;
# the two `ufw ... comment eas-station-ntp-server` entries below are scoped
# to that exact literal tag (never user input) so only rules this feature
# created can ever be added or removed through it -- an operator's own
# rules for other ports/services are never touched.
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/chrony/conf.d/eas-station-ntp-server.conf
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active --quiet chrony
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart chrony
eas-station ALL=(ALL) NOPASSWD: /usr/bin/chronyc -n clients
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw allow from * to any port 123 proto udp comment eas-station-ntp-server
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw delete allow from * to any port 123 proto udp

# Icecast Streaming (Settings -> Firewall): lets an admin choose which
# subnets can reach the Icecast port configured in Icecast settings. The
# port itself is admin-configurable (default 8000, unlike NTP's fixed 123),
# so the port position is also wildcarded here -- gated the same way as the
# subnet position: only reachable through webapp.admin.firewall's
# authenticated, system.configure-gated reconciliation, which always derives
# the port from the current IcecastSettings row, and the `comment
# eas-station-icecast` tag on the allow rule still scopes reconciliation to
# rules this feature created, same as the NTP entries above.
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw allow from * to any port * proto tcp comment eas-station-icecast
eas-station ALL=(ALL) NOPASSWD: /usr/sbin/ufw delete allow from * to any port * proto tcp

# Bad Actor Blocklist (Admin -> Application Settings): lets the web UI
# manage the nginx-level Spamhaus/local IP blocklist added in
# scripts/update_bad_actors.sh -- toggle it on/off, edit the allowlist, and
# trigger an immediate Spamhaus DROP/EDROP refresh. See
# webapp/admin/bad_actors.py. IPs/CIDRs are validated in Python before ever
# reaching these commands. nginx -t / reload nginx are already granted above.
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/nginx/bad-actors-switch.conf
eas-station ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/nginx/bad-actors-allowlist.conf
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl start bad-actors-update.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active bad-actors-update.service
eas-station ALL=(ALL) NOPASSWD: /usr/bin/systemctl show bad-actors-update.service *
