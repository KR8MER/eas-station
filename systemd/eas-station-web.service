[Unit]
Description=EAS Station Web Application
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station.target
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=eas-station
Group=eas-station
# GPIO access required for OLED button on Pi 5
SupplementaryGroups=gpio i2c
WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Prevent system site-packages from interfering with venv gevent
# This is critical when venv was created with --system-site-packages flag
# System numpy/scipy can conflict with gevent's greenlet C extensions
Environment="PYTHONNOUSERSITE=1"
# Pi 5 requires lgpio for GPIO access - prevents gpiozero auto-detection hangs
Environment="GPIOZERO_PIN_FACTORY=lgpio"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-web

# Ensure log directory exists with correct permissions before starting
# Note: The '+' prefix runs this command as root (elevated privileges required)
# This is necessary because:
#   1. The directory /var/log/eas-station must be owned by eas-station:eas-station
#   2. Only root can change ownership of files/directories (chown)
#   3. The main service runs as user 'eas-station', which cannot create system directories
# Security: This command only creates a directory and sets ownership - no user input involved
ExecStartPre=+/bin/sh -c 'mkdir -p /var/log/eas-station && touch /var/log/eas-station/eas_station.log && chown -R eas-station:eas-station /var/log/eas-station && chmod 755 /var/log/eas-station && chmod 644 /var/log/eas-station/eas_station.log'
# Check gevent compatibility (diagnose C extension conflicts from system packages)
ExecStartPre=/opt/eas-station/venv/bin/python3 /opt/eas-station/scripts/check_gevent_compat.py
# Run Gunicorn with gevent workers for Flask-SocketIO support
# IMPORTANT: gevent is REQUIRED for WebSocket functionality
# System packages (numpy, scipy, SoapySDR) may conflict with gevent C extensions
ExecStart=/opt/eas-station/venv/bin/gunicorn \
    --config gunicorn.conf.py \
    --bind 0.0.0.0:5000 \
    --workers 4 \
    --timeout 300 \
    --worker-class gevent \
    --worker-connections 1000 \
    --log-level info \
    --access-logfile - \
    --error-logfile - \
    wsgi:application

# Service management
Restart=always
RestartSec=10s
KillMode=mixed
KillSignal=SIGQUIT
TimeoutStartSec=300
TimeoutStopSec=30

# Security settings
# NoNewPrivileges disabled to allow sudo for certbot/nginx management
# The web UI needs to run certbot and control nginx service for SSL certificates
# Sudoers configuration limits which commands can be run (see /etc/sudoers.d/eas-station)
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ReadWritePaths for:
# - /opt/eas-station: Application directory
# - /var/log/eas-station: Application logs
# - /var/www: Required for certbot webroot method (ACME challenge)
# - /run: Required for nginx -t (certbot nginx plugin)
# - /etc/nginx: Required for certbot nginx plugin to modify config
# - /etc/letsencrypt: Standard Let's Encrypt directory (if used)
# - /etc/chrony: LAN NTP Server admin page writes conf.d/eas-station-ntp-server.conf here
ReadWritePaths=/opt/eas-station /var/log/eas-station /var/www /run /etc/nginx /etc/letsencrypt /etc/icecast2 /etc/chrony

# GPIO device access for OLED button on Pi 5
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip4 rw
DeviceAllow=/dev/i2c-1 rw
# Storage device access for S.M.A.R.T. health monitoring (smartctl).
# Path wildcards are NOT supported by DeviceAllow — use device group names
# from /proc/devices instead so all present and future devices match.
#   char-nvme:    NVMe controller char devices  (/dev/nvme0, /dev/nvme1, …)
#   block-blkext: NVMe namespace block devices   (/dev/nvme0n1, …)
#   block-sd:     SCSI/SATA disk block devices   (/dev/sda, /dev/sdb, …)
DeviceAllow=char-nvme rw
DeviceAllow=block-blkext rw
DeviceAllow=block-sd r
# Required capabilities for sudo to work (certbot/nginx management)
# CAP_SETUID and CAP_SETGID allow sudo to change user/group IDs
# CAP_AUDIT_WRITE allows sudo to write audit records
# CAP_SYS_ADMIN required for NVMe admin ioctls (SMART health queries)
# CAP_NET_ADMIN required for `ufw`/iptables-nft to read and modify the
# firewall ruleset (Security Center -> Checkup tab). Without it, sudo still
# escalates to uid 0, but this bounding set caps what that root process can
# do, and iptables-nft's netlink queries fail with "Could not fetch rule set
# generation id: Permission denied" -- which the checkup then misreports as
# "UFW is installed but not active" even when it's genuinely active.
# CAP_DAC_OVERRIDE required for `chronyc clients` (LAN NTP Server admin page's
# Recent Clients list). chronyd's command socket lives at
# /run/chrony/chronyd.sock inside a directory owned `_chrony` with mode 0700 --
# without this capability, sudo still escalates to uid 0, but that root
# process still can't traverse a directory it doesn't own, so chronyc falls
# back to the legacy cmdmon protocol and gets "501 Not authorised". This
# fails silently: _client_summary() treats it the same as a genuinely empty
# client list, so the page always showed "no clients yet" even after real
# clients had queried and synced successfully.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_OVERRIDE

# Resource limits
LimitNOFILE=65536
# 4000M: the web service imports numpy/scipy/numba plus all Flask/GeoAlchemy
# dependencies, which easily exceeds 512M on Pi-class hardware.  512M caused
# gunicorn workers to be silently OOM-killed by the cgroup before wsgi.py
# could finish its import, leaving no workers alive and nginx returning 502.
# Bumped from 1500M when --workers went 2->4 (2026-08-31): two workers were
# already observed using ~956M + ~474M RSS combined at 1500M, so simply
# doubling the worker count without raising this would hit the same
# OOM-kill failure mode this limit was originally raised to avoid.
MemoryMax=4000M

[Install]
WantedBy=multi-user.target eas-station.target
