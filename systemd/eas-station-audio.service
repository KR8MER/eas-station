[Unit]
Description=EAS Station Audio Processing Service
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station.target
After=network.target redis.service eas-station-sdr.service
Requires=redis.service
Wants=eas-station-sdr.service

# Fire a recovery hook if this unit ever ends up in 'failed' state.
# Notably covers crashes that happen while a stop job is already in
# flight (e.g. mid-shutdown during a full-stack restart), where
# Restart=always does not re-trigger on its own.
OnFailure=eas-station-failure-recovery@%N.service

[Service]
Type=simple
User=eas-station
Group=eas-station
# Additional group for audio device access
SupplementaryGroups=audio

WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Pi 5 requires lgpio for GPIO access - prevents gpiozero auto-detection hangs
Environment="GPIOZERO_PIN_FACTORY=lgpio"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-audio

ExecStart=/opt/eas-station/venv/bin/python eas_monitoring_service.py

# Service management
Restart=always
RestartSec=10s
# Disable the default start-limit burst (5 failures / 10 s) so systemd never
# permanently enters 'failed' state and stops retrying. The 10 s RestartSec
# already prevents a tight restart loop.
StartLimitBurst=0
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eas-station /var/log/eas-station

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target eas-station.target
