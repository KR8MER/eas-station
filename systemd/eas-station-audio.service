[Unit]
Description=EAS Station Audio Processing Service
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station.target
After=network.target redis.service eas-station-sdr.service eas-station-demod.service
Requires=redis.service
Wants=eas-station-sdr.service eas-station-demod.service

# Fire a recovery hook if this unit ever ends up in 'failed' state.
# Notably covers crashes that happen while a stop job is already in
# flight (e.g. mid-shutdown during a full-stack restart), where
# Restart=always does not re-trigger on its own.
OnFailure=eas-station-failure-recovery@%N.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=eas-station
Group=eas-station
# Additional group for audio device access
SupplementaryGroups=audio

WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Pi 5 requires lgpio for GPIO access - prevents gpiozero auto-detection hangs
Environment="GPIOZERO_PIN_FACTORY=lgpio"
# Memory diagnostics — SIGUSR1 still produces an RSS + gc-summary snapshot,
# but tracemalloc is left off in production (every allocation captured =
# CPU + RSS overhead). To re-enable for a leak hunt, add
# MEMDIAG_TRACEMALLOC=1 here, restart, and reproduce. Dumps land in
# MEMDIAG_DUMP_DIR; we override the /tmp default because PrivateTmp=true
# would hide /tmp dumps from a normal shell.
Environment="MEMDIAG_DUMP_DIR=/var/log/eas-station"
# glibc malloc tuning. This is the most heavily threaded eas-station process
# (websocket push fast+slow loops, gated-alert scheduler, per-source audio
# pipelines, ffmpeg feeder threads) and glibc defaults to one malloc arena
# per thread, each holding freed memory in a per-thread free-list instead of
# returning it to the kernel — RSS grows to multiples of the actual live
# working set. Same fix already proven on eas-station-displays.service
# (cut that service's RSS from 9.68 GB to 320 MB).
#   * MALLOC_ARENA_MAX=2 caps arena count to 2 (forces sharing).
#   * MALLOC_TRIM_THRESHOLD_=131072 lowers the threshold at which glibc
#     returns top-of-heap memory to the kernel (default is 128 KiB
#     dynamically tuned upward; pinning it low keeps RSS honest).
Environment="MALLOC_ARENA_MAX=2"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-audio

ExecStart=/opt/eas-station/venv/bin/python eas_monitoring_service.py

# Service management
Restart=always
RestartSec=10s
# Disable the default start-limit burst (5 failures / 10 s) so systemd never
# permanently enters 'failed' state and stops retrying. The 10 s RestartSec
# already prevents a tight restart loop.
StartLimitBurst=0
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eas-station /var/log/eas-station

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Scheduling priority - hosts the SAME/EAS header decoder for every audio
# source (SDR and network streams alike), plus Icecast relay and archival
# ffmpeg children. On a box running at sustained high load, this path
# starving for CPU means a missed SAME header, not just a late log line.
# Matches eas-station-demod.service's Nice=-3 -- see that unit for the
# dropped-audio-chunk evidence behind this.
Nice=-3

[Install]
WantedBy=multi-user.target eas-station.target
