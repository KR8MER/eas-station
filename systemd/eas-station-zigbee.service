[Unit]
Description=EAS Station Zigbee Subsystem (zigpy-znp coordinator, port 5102)
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station-hardware.target eas-station.target
After=network.target redis.service
Requires=redis.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=eas-station
Group=eas-station
# Zigbee subsystem needs to open the coordinator's USB serial device
# (/dev/ttyUSB*, /dev/ttyACM*, /dev/ttyAMA*) — dialout group access
# covers all three.
SupplementaryGroups=dialout

# zigpy persists its NCP/network state in /var/lib/eas-station/zigbee.db
# (see services/zigbee/coordinator.py — ZIGBEE_DB_PATH).  Declaring
# StateDirectory= asks systemd to create /var/lib/eas-station owned by
# User=/Group= before ExecStart, so the unit no longer fails with
# 226/NAMESPACE on fresh installs where the directory doesn't yet exist
# (ReadWritePaths= rejects missing directories under ProtectSystem=strict).
StateDirectory=eas-station
StateDirectoryMode=0750

WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Memory diagnostics — see eas-station-displays.service for rationale.
Environment="MEMDIAG_DUMP_DIR=/var/log/eas-station"
# glibc malloc tuning — see eas-station-displays.service for the full
# rationale.  Cap arenas to 2 and force an aggressive trim threshold
# so RSS stays honest even with the zigpy asyncio thread fighting the
# Flask API thread for allocations.
Environment="MALLOC_ARENA_MAX=2"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-zigbee

ExecStart=/opt/eas-station/venv/bin/python -m services.zigbee

# Service management
Restart=always
RestartSec=10s
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eas-station /var/log/eas-station /var/lib/eas-station

# USB serial coordinator device access. Coordinators enumerate as
# /dev/ttyUSB<n>//dev/ttyACM<n> with no stable number; DeviceAllow has
# no path wildcards, so allow the char groups (same pattern as
# web.service). ttyAMA0 covers HAT-style coordinators on the Pi UART.
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=/dev/ttyAMA0 rw

# Resource limits
#
# MemoryMax is a HARD cgroup limit: exceeding it gets the process OOM-killed,
# and with Restart=always that becomes a silent crash loop rather than a
# visible failure.  This service imports app_core.models, which transitively
# pulls in the DSP stack (app_utils.eas_decode -> eas_demod -> numba -> scipy
# + numpy) and lands around 240 MB RSS before it does any work at all.  The
# previous 128M ceiling was therefore unreachable — the unit was killed during
# startup on every restart.  Keep this at or above 384M; see
# tests/test_systemd_memory_limits.py, which fails if it is lowered.
LimitNOFILE=65536
MemoryMax=384M

[Install]
WantedBy=multi-user.target eas-station-hardware.target
