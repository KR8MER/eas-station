[Unit]
Description=EAS Station GPIO Subsystem (relays + alert indicators, port 5105)
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station-hardware.target eas-station.target
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=eas-station
Group=eas-station
# GPIO subsystem needs:
#   * gpio     — relay pins (BCM via gpiozero / lgpio) + NeoPixel data line
#   * dialout  — USB tower light (CH34x serial)
SupplementaryGroups=gpio dialout

WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Pi 5 requires lgpio for GPIO access — prevents gpiozero
# auto-detection from hanging when it probes RPi.GPIO first.
Environment="GPIOZERO_PIN_FACTORY=lgpio"
# Memory diagnostics — see eas-station-displays.service for rationale.
Environment="MEMDIAG_DUMP_DIR=/var/log/eas-station"
# glibc malloc tuning — see eas-station-displays.service for the full
# rationale.
Environment="MALLOC_ARENA_MAX=2"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-gpio

ExecStart=/opt/eas-station/venv/bin/python -m services.gpio

# Service management
Restart=always
RestartSec=10s
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eas-station /var/log/eas-station -/dev/gpiochip0 -/dev/gpiochip1

# GPIO chips for relay control + NeoPixel data line
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip1 rw
# USB tower light — CH34x/CP210x adapters enumerate as /dev/ttyUSB<n>
# with no stable number, and a fixed /dev/ttyUSB0 entry EPERMs the open
# when the light lands on ttyUSB1. Path wildcards are NOT supported by
# DeviceAllow — use device group names (same pattern as web.service).
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw

# Resource limits
LimitNOFILE=65536
MemoryMax=128M

[Install]
WantedBy=multi-user.target eas-station-hardware.target
