[Unit]
Description=EAS Station Network Subsystem (nmcli proxy, port 5101)
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station-hardware.target eas-station.target
After=network.target redis.service NetworkManager.service
Requires=redis.service
Wants=NetworkManager.service

[Service]
Type=simple
User=eas-station
Group=eas-station
# Network subsystem talks to NetworkManager via DBus; the eas-station
# user is granted that via the polkit rule shipped in config/.  No
# device groups are needed — nmcli runs as the unprivileged user and
# everything privileged goes through DBus.

WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Memory diagnostics — SIGUSR1 still produces an RSS + gc-summary
# snapshot.  See systemd/eas-station-displays.service for the full
# rationale.  Dumps land in MEMDIAG_DUMP_DIR; we override the /tmp
# default because PrivateTmp=true would hide /tmp dumps from a normal
# shell.
Environment="MEMDIAG_DUMP_DIR=/var/log/eas-station"
# glibc malloc tuning — see eas-station-displays.service for the full
# rationale.  Cap arenas to 2 and force an aggressive trim threshold
# so RSS stays honest even with multiple worker threads.
Environment="MALLOC_ARENA_MAX=2"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-network

ExecStart=/opt/eas-station/venv/bin/python -m services.network

# Service management
Restart=always
RestartSec=10s
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eas-station /var/log/eas-station

# Resource limits
#
# MemoryMax is a HARD cgroup limit: exceeding it gets the process OOM-killed,
# and with Restart=always that becomes a silent crash loop rather than a
# visible failure.  This service imports app_core.models, which transitively
# pulls in the DSP stack (app_utils.eas_decode -> eas_demod -> numba -> scipy
# + numpy) and lands around 240 MB RSS before it does any work at all.  The
# previous 128M ceiling was therefore unreachable — the unit was killed during
# startup on every restart.  Keep this at or above 384M; see
# tests/test_systemd_memory_limits.py, which fails if it is lowered.
LimitNOFILE=65536
MemoryMax=384M

[Install]
WantedBy=multi-user.target eas-station-hardware.target
