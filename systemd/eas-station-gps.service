[Unit]
Description=EAS Station GPS Subsystem (GPS manager + trends, port 5103)
Documentation=https://github.com/KR8MER/eas-station
PartOf=eas-station-hardware.target eas-station.target
# Ordering only (no Wants/Requires): when gpsd is also being started in the
# same systemd transaction — at boot, or when update.sh restarts the timing
# stack — wait for it so the GPS manager finds gpsd already listening and
# connects to it (source=gpsd) instead of losing the race and falling back to
# grabbing the serial port directly (source=serial), which then starves gpsd.
# Harmless on installs without gpsd: an absent unit in After= is ignored.
After=network.target redis.service gpsd.service gpsd.socket
Requires=redis.service

[Service]
Type=simple
User=eas-station
Group=eas-station
# GPS subsystem talks to:
#   * /dev/serial0 / /dev/ttyAMA*       — NMEA stream (dialout)
#   * /dev/gpiochip*                    — PPS pulse line (gpio)
# The PPS line uses gpiozero to register an interrupt callback on the
# configured pin (GPIO 18 by default), so the gpio group is required
# even though no other GPIO pin is touched.
SupplementaryGroups=dialout gpio

WorkingDirectory=/opt/eas-station
Environment="PATH=/opt/eas-station/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/eas-station"
# Pi 5 requires lgpio for GPIO access — prevents gpiozero
# auto-detection from hanging when it probes RPi.GPIO first.
Environment="GPIOZERO_PIN_FACTORY=lgpio"
# Memory diagnostics — see eas-station-displays.service for rationale.
Environment="MEMDIAG_DUMP_DIR=/var/log/eas-station"
# glibc malloc tuning — see eas-station-displays.service for the full
# rationale.  Critical for this subsystem because the NMEA reader,
# the PPS-jitter ring (16 384 floats), and the chrony sampler all
# churn through small allocations on a hot loop.
Environment="MALLOC_ARENA_MAX=2"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
EnvironmentFile=/opt/eas-station/.env

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eas-station-gps

ExecStart=/opt/eas-station/venv/bin/python -m services.gps

# Service management
Restart=always
RestartSec=10s
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
# CAP_SYS_TIME lets the GPS manager call clock_settime(2) directly so
# it can sync the system clock without sudo (which NoNewPrivileges
# blocks).
AmbientCapabilities=CAP_SYS_TIME
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eas-station /var/log/eas-station -/dev/gpiochip0 -/dev/gpiochip1

# Serial UART for GPS HAT (the /dev/serial0 symlink target varies by
# Pi model — Pi 5 uses /dev/ttyAMA10, Pi 4 uses /dev/ttyAMA0)
DeviceAllow=/dev/ttyAMA0 rw
DeviceAllow=/dev/ttyAMA10 rw
DeviceAllow=/dev/ttyS0 rw
# USB GPS receivers enumerate as /dev/ttyUSB<n>//dev/ttyACM<n>; allow
# the char groups since DeviceAllow has no path wildcards.
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
# PPS GPIO pin
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip1 rw

# Resource limits
#
# MemoryMax is a HARD cgroup limit: exceeding it gets the process OOM-killed,
# and with Restart=always that becomes a silent crash loop rather than a
# visible failure.  This service imports app_core.models, which transitively
# pulls in the DSP stack (app_utils.eas_decode -> eas_demod -> numba -> scipy
# + numpy) and lands around 240 MB RSS before it does any work at all.  The
# previous 128M ceiling was therefore unreachable — the unit was killed during
# startup on every restart.  Keep this at or above 384M; see
# tests/test_systemd_memory_limits.py, which fails if it is lowered.
LimitNOFILE=65536
MemoryMax=384M

[Install]
WantedBy=multi-user.target eas-station-hardware.target
